@model Data.ViewModels.ReportViewModel
@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>MedImaging Data Bank - Report</title>
    <style>
        html, body {
            width: 100%;
            max-width: 100%;
            margin: 0 auto;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 16px;
            color: #222;
            background-color: #fff;
            width: 100%;
        }

        * {
            box-sizing: border-box;
        }

        header {
            border-bottom: 3px solid #f37438;
            padding-bottom: 10px;
            margin-bottom: 25px;
        }

        .brand {
            font-size: 22px;
            color: #f37438;
            font-weight: bold;
        }

        .subtitle {
            font-size: 13px;
            color: #888;
        }

        .title {
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            color: #f37438;
            margin: 20px 0;
        }

        .info {
            margin-bottom: 15px;
            font-size: 14px;
        }

            .info span {
                display: inline-block;
                width: 180px;
                color: #555;
                font-weight: 600;
            }

        h3 {
            color: #f37438;
            font-size: 16px;
            margin-top: 25px;
            border-bottom: 1px solid #eee;
            padding-bottom: 5px;
        }

        p {
            margin: 8px 0;
            line-height: 1.5;
        }

        footer {
            border-top: 1px solid #ddd;
            text-align: center;
            margin-top: 40px;
            padding-top: 10px;
            font-size: 12px;
            color: #888;
        }
    </style>
</head>
<body>
    <header>
        <div class="brand">MedImaging Data Bank</div>
        <div class="subtitle">Confidential Radiology Report</div>
    </header>

    <div class="title">Imaging Study Report</div>

    <div class="info">
        <div><span>Patient Name:</span> **********</div>
        <div><span>Patient ID:</span> **********</div>
        <div><span>Age:</span> @Model.Age</div>
        <div><span>Gender:</span> @Model.Sex</div>
        <div><span>Institution:</span> **********</div>
        <div><span>Study Date:</span> @Model.StudyDate</div>
    </div>

    <h3>Study Name</h3>
    <p>@Html.Raw(Model.Exam)</p>

    <h3>Clinical Information</h3>
    <p>@Html.Raw(Model.ClinicalInformation)</p>

    <h3>Findings</h3>
    <p>@Html.Raw(Model.Findings)</p>

    <h3>Conclusion</h3>
    <p>@Html.Raw(Model.Conclusion)</p>
</body>
</html>
